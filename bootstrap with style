              <div class="col-12"><label class="form-label small fw-semibold">Тема</label><select class="form-select-custom w-100"><option>Вопрос о мебели</option><option>Заказ и доставка</option><option>Посещение шоурума</option></select></div>
              <div class="col-12"><label class="form-label small fw-semibold">Сообщение</label><textarea class="form-control-custom w-100" rows="3" placeholder="Ваш текст..."></textarea></div>
              <div class="col-12"><button type="button" class="btn btn-teal" id="sendMsgBtn" data-bs-toggle="popover" data-bs-trigger="focus" title=" Наш адрес" data-bs-content="г. Гродно, ул. Советских Пограничников д.2">Отправить</button>
              <button type="button" class="btn btn-link ms-2" data-bs-toggle="tooltip" data-bs-title="Ждём вас в шоуруме!"><i class="bi bi-question-circle"></i></button></div>
            </div>
          </form>
          <div id="progressContainer" class="mt-3 d-none"><div class="d-flex justify-content-between small mb-1"><span>Отправка...</span><span id="progressPercent">0%</span></div><div class="progress progress-custom"><div id="demoProgress" class="progress-bar bg-teal" style="width:0%"></div></div></div>
          <div id="spinnerLoader" class="text-center mt-3 d-none"><div class="spinner-grow text-teal" role="status"></div><span class="ms-2">Отправляем...</span></div>
        </div>
        <!-- сворачиваемый блок о компании -->
        <div class="bg-white p-4 rounded-3 shadow-sm mt-4">
          <h4><i class="bi bi-tree-fill"></i> Наша философия</h4>
          <p>Мебель из натуральных материалов, ручная работа и забота об экологии.</p>
          <button class="btn btn-sm btn-outline-teal" type="button" data-bs-toggle="collapse" data-bs-target="#readMoreBlock">Подробнее →</button>
          <div class="collapse mt-3" id="readMoreBlock"><div class="card card-body bg-light">Мы используем сертифицированную древесину и нетоксичные краски. Каждая покупка помогает высадить дерево в Беловежской пуще.</div></div>
        </div>
      </div>
    </div>

    <!-- ========== БЛОК КОММЕНТАРИЕВ (ровно) ========== -->
    <div class="comment-section mt-5">
      <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
        <h3 class="mb-2"><i class="bi bi-star-fill me-2" style="color:var(--teal);"></i> Отзывы наших клиентов</h3>
        <button class="btn btn-teal btn-submit-comment" data-bs-toggle="collapse" data-bs-target="#newCommentForm" aria-expanded="false">+ Оставить отзыв</button>
      </div>
      <div class="collapse mb-4" id="newCommentForm">
        <div class="card p-3 border-0 shadow-sm">
          <div class="mb-3"><input type="text" class="form-control" id="commentAuthor" placeholder="Ваше имя"></div>
          <div class="mb-3"><textarea class="form-control" rows="2" id="commentText" placeholder="Поделитесь впечатлениями о мебели или посещении офиса..."></textarea></div>
          <div><button class="btn btn-outline-teal" id="publishCommentBtn">Опубликовать</button></div>
        </div>
      </div>
      <div id="commentsList">
        <div class="comment-card d-flex gap-3"><div class="comment-avatar">АК</div><div><h6 class="mb-0">Анна Ковальчук <span class="comment-date ms-2">★ ★ ★ ★ ★</span></h6><p class="mb-0 mt-1">Офис на Советских Пограничников очень удобно расположен! Консультанты помогли подобрать идеальный стол.</p><small class="text-muted">3 дня назад</small></div></div>
        <div class="comment-card d-flex gap-3"><div class="comment-avatar">ДМ</div><div><h6 class="mb-0">Дмитрий Мороз <span class="comment-date ms-2">★ ★ ★ ★ ☆</span></h6><p class="mb-0 mt-1">Отличный шоурум в Гродно. Качество мебели порадовало, доставка вовремя.</p><small class="text-muted">1 неделю назад</small></div></div>
      </div>
    </div>
  </div>
</section>

<!-- Модальное окно и тост -->
<div class="modal fade" id="newsletterModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Скидка 10%</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="email" class="form-control" placeholder="Ваш email"></div><div class="modal-footer"><button class="btn btn-teal" data-bs-dismiss="modal">Подписаться</button></div></div></div></div>
<div class="toast-container position-fixed bottom-0 end-0 p-3"><div id="liveToast" class="toast" data-bs-autohide="true" data-bs-delay="3000"><div class="toast-header bg-teal text-white"><i class="bi bi-bag-check me-2"></i><strong>FurniShop</strong><button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button></div><div class="toast-body" id="toastMessage">Товар добавлен!</div></div></div>

<footer class="footer"><div class="container"><div class="row pb-5"><div class="col-lg-3 col-md-6 mb-4"><div class="footer-logo mb-3">FurniShop</div><div class="d-flex gap-2"><a href="#" class="social-icon"><i class="bi bi-twitter-x"></i></a><a href="#" class="social-icon"><i class="bi bi-facebook"></i></a><a href="#" class="social-icon"><i class="bi bi-instagram"></i></a></div><p class="small mt-2">ул. Советских Пограничников, 2, Гродно</p></div><div class="col-lg-2 col-md-6 mb-4"><h5>Продукты</h5><ul class="list-unstyled"><li><a href="#">Каталог</a></li><li><a href="#">Акции</a></li></ul></div></div><div class="text-center py-3 small text-white-50">© FurniShop 2025 — Мебель с душой в Гродно</div></div></footer>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Инициализация Bootstrap-компонентов
    [...document.querySelectorAll('[data-bs-toggle="tooltip"]')].forEach(el=>new bootstrap.Tooltip(el));
    [...document.querySelectorAll('[data-bs-toggle="popover"]')].forEach(el=>new bootstrap.Popover(el));
    new bootstrap.ScrollSpy(document.body, { target: '#navbarMain', offset: 70 });
    
    // Корзина 
    let cart = [];
    function updateCartUI(){
      const cartDiv=document.getElementById('cartItemsList'), totalSpan=document.getElementById('cartTotal'), badge=document.getElementById('cartCountBadge');
      if(cart.length===0){ cartDiv.innerHTML='<p class="text-muted text-center">Корзина пуста.</p>'; totalSpan.innerText='€0.00'; badge.innerText='0'; return; }
      let total=0; let html='<ul class="list-group list-group-flush">';
      cart.forEach((item,idx)=>{ total+=item.price; html+=`<li class="list-group-item d-flex justify-content-between"><div><img src="${item.img}" class="cart-item-img me-2" width="45" height="45">${item.name}</div><span>€${item.price}</span><button class="btn btn-sm btn-outline-danger remove-item" data-index="${idx}">✖</button></li>`; });
      html+='</ul>'; cartDiv.innerHTML=html; totalSpan.innerText=`€${total.toFixed(2)}`; badge.innerText=cart.length;
      document.querySelectorAll('.remove-item').forEach(btn=>btn.addEventListener('click',(e)=>{ let idx=parseInt(btn.dataset.index); cart.splice(idx,1); updateCartUI(); showToast('Товар удалён'); }));
    }
    window.showToast=(msg)=>{ document.getElementById('toastMessage').innerText=msg; new bootstrap.Toast(document.getElementById('liveToast')).show(); };
    window.addToCart=(name,price,img)=>{ cart.push({name,price,img}); updateCartUI(); showToast(`${name} добавлен в корзину!`); };
    const productsData=[{name:"Потолочный светильник",price:75,old:99,img:"201ac132116bcc90e2f261a81a619ef41d7f44e6.jpg"},{name:"Стул Wood",price:50,old:75,img:"77c74dd8622f631535544d7a3babe67e9aa6a8c8.png"},{name:"Комод Papper",price:105,old:140,img:"b9ee5648b41571a60974d3b3e79c8f3d942cbb65.jpg"},{name:"Кресло Ole",price:60,old:80,img:"d2550c0bc4b77808832583fe3242fb027c890183.jpg"},{name:"Шкаф Treos",price:200,old:260,img:"2f3199c8ac5d27f084ee350a6571863d1199a131.jpg"},{name:"Стол Multi",price:44,old:55,img:"5a49214161f50f0a929288ea5e402cc0ae89bde7.jpg"},{name:"Стол-книжка XORA",price:320,old:400,img:"74d0206c55d7389b12ec68b56e8686eb48107e66.jpg"},{name:"Гарнитур Black Forest",price:625,old:700,img:"e9e51778f3e0a05db2edf04624c49158fc659aad.jpg"}];
    const container=document.getElementById('productsRow');
    if(container) productsData.forEach(p=>{ container.innerHTML+=`<div class="col-md-3 col-6"><div class="product-card"><div class="product-img-wrap"><img src="${p.img}" class="w-100"><button class="add-btn" onclick="addToCart('${p.name}',${p.price},'${p.img}')">+</button></div><div class="p-3"><span class="fw-semibold">${p.name}</span><div><span class="price-new">€${p.price}</span><span class="price-old">€${p.old}</span></div></div></div></div>`; });
    document.getElementById('showToastBtn')?.addEventListener('click',(e)=>{ e.preventDefault(); showToast('✨ Скидка 15% на кресла!'); });
    document.getElementById('heroShopBtn')?.addEventListener('click',(e)=>{ e.preventDefault(); new bootstrap.Modal(document.getElementById('newsletterModal')).show(); });
    // прогресс-бар для отправки сообщения
    const sendBtn=document.getElementById('sendMsgBtn');
    if(sendBtn){
      sendBtn.addEventListener('click',()=>{ const progCont=document.getElementById('progressContainer'), spin=document.getElementById('spinnerLoader'); progCont.classList.remove('d-none'); spin.classList.remove('d-none'); let w=0, bar=document.getElementById('demoProgress'), perc=document.getElementById('progressPercent'); const intv=setInterval(()=>{ if(w>=100){ clearInterval(intv); setTimeout(()=>{ progCont.classList.add('d-none'); spin.classList.add('d-none'); showToast('Сообщение отправлено! Мы свяжемся с вами.'); },500); } else { w+=20; bar.style.width=w+'%'; if(perc) perc.innerText=w+'%'; } },200); });
    }
    // комментарии
    document.getElementById('publishCommentBtn')?.addEventListener('click',()=>{ let author=document.getElementById('commentAuthor').value.trim(); let text=document.getElementById('commentText').value.trim(); if(!author) author='Гость'; if(!text) return; const commentDiv=document.createElement('div'); commentDiv.className='comment-card d-flex gap-3'; const letter=author.charAt(0).toUpperCase(); commentDiv.innerHTML=`<div class="comment-avatar">${letter}</div><div><h6 class="mb-0">${escapeHtml(author)} <span class="comment-date ms-2">★ ★ ★ ★ ☆</span></h6><p class="mb-0 mt-1">${escapeHtml(text)}</p><small class="text-muted">Только что</small></div>`; document.getElementById('commentsList').prepend(commentDiv); document.getElementById('commentAuthor').value=''; document.getElementById('commentText').value=''; showToast('Спасибо за отзыв!'); });
    function escapeHtml(str){ if(!str) return ''; return str.replace(/[&<>]/g, function(m){if(m==='&') return '&amp;'; if(m==='<') return '&lt;'; if(m==='>') return '&gt;'; return m;}); }
    updateCartUI();
  });
</script>
</body>
</html>
